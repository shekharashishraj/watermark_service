     float init_opacity = 0.1f; // gsplat simple_trainer.py:167 init_opa
     float init_scale = 1.0f;   // gsplat simple_trainer.py:169 init_scale — 3-NN distance multiplier
     int sh_degree = 3;
+    // O-SCD (PocketGS "disc-like covariance seeding"): when TrainingInput.seed_normals is present, a
+    // point with a non-zero normal starts as a disc tangent to the surface — the local z axis is the
+    // normal, the tangential scales are the 3-NN distance × init_scale, and the normal scale is that
+    // × normal_scale_ratio. Points with a zero normal (and all points when no normals are given) keep
+    // the isotropic start above.
+    float normal_scale_ratio = 0.1f;
 };
 
