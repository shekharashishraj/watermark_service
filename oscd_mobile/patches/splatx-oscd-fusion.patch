diff --git a/Sources/SplatXTrainC/OscdFusionC.cpp b/Sources/SplatXTrainC/OscdFusionC.cpp
new file mode 100644
index 0000000..12ca8bb
--- /dev/null
+++ b/Sources/SplatXTrainC/OscdFusionC.cpp
@@ -0,0 +1,193 @@
+// oscd_mobile patch — C API for O-SCD change fusion. See include/oscd_fusion_c.h.
+#include "oscd_fusion_c.h"
+
+#include "splatx/MetalBackend.h"
+#include "splatx/OscdFusion.h"
+#include "splatx/PlyIO.h"
+
+#include <cmath>
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+#include <string>
+
+struct OscdDepth {
+    std::unique_ptr<splatx::KernelBackend> backend;   // declared first: destroyed after the renderer
+    std::unique_ptr<splatx::oscd::DepthRenderer> renderer;
+};
+
+struct OscdFusion {
+    std::unique_ptr<splatx::KernelBackend> backend;   // declared first: destroyed after fusion
+    std::unique_ptr<splatx::oscd::ChangeFusion> fusion;
+};
+
+namespace {
+void set_err(char* buf, int32_t len, const char* msg) {
+    if (!buf || len <= 0) return;
+    std::strncpy(buf, msg, static_cast<size_t>(len) - 1);
+    buf[len - 1] = '\0';
+}
+
+splatx::TrainingCamera camera(const float* viewmat, float fx, float fy, float cx, float cy,
+                              int32_t width, int32_t height) {
+    if (!viewmat || width < 1 || height < 1 || !(fx > 0) || !(fy > 0))
+        throw std::invalid_argument("invalid camera");
+    splatx::TrainingCamera cam;
+    std::memcpy(cam.viewmat, viewmat, sizeof(cam.viewmat));
+    const float K[9] = {fx, 0, cx, 0, fy, cy, 0, 0, 1};
+    std::memcpy(cam.K, K, sizeof(K));
+    cam.width = width;
+    cam.height = height;
+    return cam;
+}
+
+template <typename Fn>
+int32_t guarded(char* err, int32_t len, Fn&& fn) {
+    try {
+        fn();
+        return 0;
+    } catch (const std::exception& e) {
+        set_err(err, len, e.what());
+        return -2;
+    } catch (...) {
+        set_err(err, len, "unknown error");
+        return -2;
+    }
+}
+} // namespace
+
+extern "C" float oscd_ssf_loss_and_grad(const float* render, const float* cue, const uint8_t* valid,
+                                        int32_t width, int32_t height, float* v_render) {
+    return splatx::oscd::ssf_loss_and_grad(render, cue, valid, width, height, v_render);
+}
+
+extern "C" void oscd_torch_adam(float* param, const float* grad, float* exp_avg, float* exp_avg_sq,
+                                int64_t n, int32_t step, float lr) {
+    splatx::oscd::torch_adam(param, grad, exp_avg, exp_avg_sq, static_cast<size_t>(n), step, lr);
+}
+
+extern "C" OscdFusion* oscd_fusion_open(const char* ply_path, const char* kernel_src_dir,
+                                        const float* reference_centres, int32_t n_centres,
+                                        uint32_t seed, char* err, int32_t err_len) {
+    try {
+        if (!ply_path) throw std::invalid_argument("ply_path must be given");
+        splatx::SplatCloud cloud = splatx::read_inria_ply(ply_path);
+        std::vector<std::array<float, 3>> centres;
+        for (int32_t i = 0; i < n_centres; i++)
+            centres.push_back({reference_centres[i * 3], reference_centres[i * 3 + 1], reference_centres[i * 3 + 2]});
+        splatx::MetalBackendDesc desc;
+        desc.search_exe_dir = true;
+        desc.kernel_src_dir = kernel_src_dir ? std::string(kernel_src_dir) : KERNEL_SRC_DIR;
+        auto f = std::make_unique<OscdFusion>();
+        f->backend = splatx::make_metal_backend(nullptr, desc);
+        splatx::oscd::FusionConfig cfg;
+        cfg.seed = seed;
+        f->fusion = std::make_unique<splatx::oscd::ChangeFusion>(*f->backend, std::move(cloud), std::move(centres), cfg);
+        return f.release();
+    } catch (const std::exception& e) {
+        set_err(err, err_len, e.what());
+        return nullptr;
+    } catch (...) {
+        set_err(err, err_len, "unknown error");
+        return nullptr;
+    }
+}
+
+extern "C" int32_t oscd_fusion_add_frame(OscdFusion* f, const float* viewmat, float fx, float fy,
+                                         float cx, float cy, int32_t width, int32_t height,
+                                         const float* cue, const uint8_t* valid, char* err, int32_t err_len) {
+    if (!f || !cue || !valid) return -1;
+    return guarded(err, err_len, [&] {
+        splatx::oscd::FusionFrame fr;
+        fr.cam = camera(viewmat, fx, fy, cx, cy, width, height);
+        const size_t n = static_cast<size_t>(width) * height;
+        fr.cue.assign(cue, cue + n);
+        fr.valid.assign(valid, valid + n);
+        f->fusion->add_frame(std::move(fr));
+    });
+}
+
+extern "C" int32_t oscd_fusion_step_frame(OscdFusion* f, float* out_loss, char* err, int32_t err_len) {
+    if (!f) return -1;
+    return guarded(err, err_len, [&] {
+        const float loss = f->fusion->step_newest_frame();
+        if (out_loss) *out_loss = loss;
+    });
+}
+
+extern "C" int32_t oscd_fusion_refine(OscdFusion* f, char* err, int32_t err_len) {
+    if (!f) return -1;
+    return guarded(err, err_len, [&] { f->fusion->refine(); });
+}
+
+extern "C" int32_t oscd_fusion_change_map(OscdFusion* f, const float* viewmat, float fx, float fy,
+                                          float cx, float cy, int32_t width, int32_t height,
+                                          float* out, char* err, int32_t err_len) {
+    if (!f || !out) return -1;
+    return guarded(err, err_len, [&] {
+        const std::vector<float> m = f->fusion->change_map(camera(viewmat, fx, fy, cx, cy, width, height));
+        std::memcpy(out, m.data(), m.size() * sizeof(float));
+    });
+}
+
+extern "C" int64_t oscd_fusion_count(OscdFusion* f) { return f ? f->fusion->count() : -1; }
+extern "C" int32_t oscd_fusion_total_steps(OscdFusion* f) { return f ? f->fusion->total_steps() : -1; }
+
+extern "C" int32_t oscd_fusion_debug_densify(OscdFusion* f, const float* grads, int64_t n, float threshold,
+                                             float extent, char* err, int32_t err_len) {
+    if (!f || !grads) return -1;
+    return guarded(err, err_len, [&] {
+        if (n != f->fusion->count()) throw std::invalid_argument("grads must have one value per Gaussian");
+        f->fusion->densify(std::vector<float>(grads, grads + n), threshold, extent);
+    });
+}
+
+extern "C" int32_t oscd_fusion_debug_prune(OscdFusion* f, float min_opacity, char* err, int32_t err_len) {
+    if (!f) return -1;
+    return guarded(err, err_len, [&] { f->fusion->prune_opacity(min_opacity); });
+}
+
+extern "C" int32_t oscd_fusion_debug_reset_opacity(OscdFusion* f, char* err, int32_t err_len) {
+    if (!f) return -1;
+    return guarded(err, err_len, [&] { f->fusion->reset_opacity(); });
+}
+
+extern "C" int64_t oscd_fusion_debug_params(OscdFusion* f, float* log_scales, float* opacities, int64_t capacity) {
+    if (!f) return -1;
+    const splatx::SplatCloud& c = f->fusion->cloud();
+    if (capacity < c.count) return -1;
+    std::memcpy(log_scales, c.scales.data(), static_cast<size_t>(c.count) * 3 * sizeof(float));
+    for (int64_t i = 0; i < c.count; i++) opacities[i] = 1.0f / (1.0f + std::exp(-c.opacities[i]));
+    return c.count;
+}
+
+extern "C" void oscd_fusion_close(OscdFusion* f) { delete f; }
+
+extern "C" OscdDepth* oscd_depth_open(const char* ply_path, const char* kernel_src_dir, char* err,
+                                      int32_t err_len) {
+    try {
+        if (!ply_path) throw std::invalid_argument("ply_path must be given");
+        splatx::MetalBackendDesc desc;
+        desc.search_exe_dir = true;
+        desc.kernel_src_dir = kernel_src_dir ? std::string(kernel_src_dir) : KERNEL_SRC_DIR;
+        auto d = std::make_unique<OscdDepth>();
+        d->backend = splatx::make_metal_backend(nullptr, desc);
+        d->renderer = std::make_unique<splatx::oscd::DepthRenderer>(*d->backend, splatx::read_inria_ply(ply_path));
+        return d.release();
+    } catch (const std::exception& e) {
+        set_err(err, err_len, e.what());
+        return nullptr;
+    }
+}
+
+extern "C" int32_t oscd_depth_render(OscdDepth* d, const float* viewmat, float fx, float fy, float cx,
+                                     float cy, int32_t width, int32_t height, float min_alpha,
+                                     float* out, char* err, int32_t err_len) {
+    if (!d || !out) { set_err(err, err_len, "null depth renderer or output"); return -1; }
+    return guarded(err, err_len, [&] {
+        const auto depth = d->renderer->expected_depth(camera(viewmat, fx, fy, cx, cy, width, height), min_alpha);
+        std::memcpy(out, depth.data(), depth.size() * sizeof(float));
+    });
+}
+
+extern "C" void oscd_depth_close(OscdDepth* d) { delete d; }
