@@ -0,0 +1,115 @@
+// oscd_mobile patch — O-SCD change fusion (Changes in Real Time, CVPR 2026; code @3abfeaa) on splatx.
+// R_change is a copy of the reference Gaussians with f_dc = 0, rendered at SH degree 0; colour,
+// opacity, scale and rotation are optimised with torch.optim.Adam semantics against O-SCD's
+// self-supervised fusion (SSF) loss while positions stay frozen. Citations are to O-SCD's oscd.py
+// and scene/gaussian_model.py. Single-thread use only (splatx's Trainer contract).
+#pragma once
+#include "splatx/KernelBackend.h"
+#include "splatx/SplatCloud.h"
+#include "splatx/Trainer.h"
+#include "splatx/TrainingInput.h"
+
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <random>
+#include <vector>
+
+namespace splatx::oscd {
+
+// SSF loss (oscd.py:221-226 online, :277-280 refine) over the pixels with valid != 0 (spec D3; O-SCD
+// averages over all pixels): with r clamped to [0,1] (gaussian_renderer:202), M = mean_c r,
+// m = sigmoid(M): loss = mean(C·(1−m)) + log(mean(m)² + log_constant). Writes d loss / d raw render
+// into v_render [H,W,3] (zero where a channel is clamped or the pixel is invalid). Returns the loss.
+float ssf_loss_and_grad(const float* render, const float* cue, const uint8_t* valid, int width,
+                        int height, float* v_render, float log_constant = 1.0f);
+
+// One torch.optim.Adam step (bias-corrected; eps added after the bias-corrected sqrt), in place.
+// `step` is the 1-based step count after this update.
+void torch_adam(float* param, const float* grad, float* exp_avg, float* exp_avg_sq, size_t n,
+                int step, float lr, float beta1 = 0.9f, float beta2 = 0.999f, float eps = 1e-15f);
+
+struct FusionConfig {
+    float lr_sh0 = 0.0025f;        // feature_lr
+    float lr_opacity = 0.025f;     // opacity_lr
+    float lr_scale = 0.005f;       // scaling_lr
+    float lr_quat = 0.001f;        // rotation_lr   (xyz: spatial_lr_scale = 0 → frozen)
+    int steps_per_frame = 16;      // oscd.py:207
+    float newest_threshold = 0.33f; // oscd.py:209: rand() > 0.33 → uniform over seen frames, else newest
+    int densify_step = 4;          // oscd.py:245 (iteration index within the frame)
+    float online_grad_threshold = 1e-3f;   // densify_grad_threshold (2e-4) × 5
+    float percent_dense = 0.01f;
+    int refine_total = 3000;       // --refine: up to 3000 total steps, online steps included
+    int densification_interval = 100;
+    float refine_grad_threshold = 2e-4f;
+    float refine_min_opacity = 0.4f;
+    int opacity_reset_interval = 2000;     // oscd.py:304
+    uint32_t seed = 0;
+};
+
+struct FusionFrame {
+    TrainingCamera cam;                    // world→camera viewmat (row-major) + pinhole K
+    std::vector<float> cue;                // [H·W] O-SCD candidate map C in [0,2]
+    std::vector<uint8_t> valid;            // [H·W] D3 validity
+};
+
+class ChangeFusion {
+public:
+    // reference: the reference cloud (any SH degree); reference_centres: reference camera centres
+    // (world), which enter O-SCD's scene extent (oscd.py:248-250) together with each added frame's.
+    ChangeFusion(KernelBackend& backend, SplatCloud reference,
+                 std::vector<std::array<float, 3>> reference_centres, FusionConfig cfg = {});
+
+    void add_frame(FusionFrame frame);
+    // O-SCD's per-frame inner loop (oscd.py:207-255) for the newest frame. Returns the last loss.
+    float step_newest_frame();
+    // O-SCD --refine (oscd.py:266-305): continue to cfg.refine_total total steps.
+    void refine();
+    // Channel mean of the clamped render at `cam` ([H·W]); O-SCD's mask is value > 0.5 (oscd.py:258-263).
+    std::vector<float> change_map(const TrainingCamera& cam);
+
+    int64_t count() const { return trainer_->splat_count(); }
+    int total_steps() const { return total_steps_; }
+    size_t frame_count() const { return frames_.size(); }
+    float extent() const;
+    const SplatCloud& cloud() { return trainer_->cloud(); }
+
+    // O-SCD gaussian_model.py, exposed for tests.
+    void densify(const std::vector<float>& grads, float threshold, float extent); // clone, then split
+    void prune_opacity(float min_opacity);
+    void reset_opacity();
+
+private:
+    float optimise_on(size_t frame_index, float log_constant);
+    void append_rows(const std::vector<int64_t>& src, const std::vector<float>* new_means,
+                     const std::vector<float>* new_scales);
+    void remove_rows(const std::vector<uint8_t>& remove);
+    void reset_stats();
+
+    std::unique_ptr<Trainer> trainer_;
+    FusionConfig cfg_;
+    std::vector<FusionFrame> frames_;
+    std::vector<std::array<float, 3>> centres_;
+    // Adam moments per parameter group (torch keeps one step count per tensor; all groups step together)
+    std::vector<float> m_sh0_, v_sh0_, m_op_, v_op_, m_sc_, v_sc_, m_q_, v_q_;
+    int adam_steps_ = 0;
+    std::vector<float> grad_accum_, denom_;   // xyz_gradient_accum, denom
+    int total_steps_ = 0;
+    std::mt19937 rng_;
+};
+
+// Expected depth of the reference (Method B depth cue, spec §8.1): Σ wᵢzᵢ / Σ wᵢ, zᵢ the camera-space
+// depth of Gaussian i's centre and wᵢ its alpha-compositing weight. One render with channel 0 = zᵢ and
+// channel 1 = 1 (splatx clamps colours only below 0) gives both sums. Single-thread use only.
+class DepthRenderer {
+public:
+    DepthRenderer(KernelBackend& backend, SplatCloud reference);
+    // [H·W] metres; NaN where Σ wᵢ < min_alpha (the reference does not cover the pixel).
+    std::vector<float> expected_depth(const TrainingCamera& cam, float min_alpha = 0.5f);
+
+private:
+    std::unique_ptr<Trainer> trainer_;
+    std::vector<float> means_;
+};
+
+} // namespace splatx::oscd
