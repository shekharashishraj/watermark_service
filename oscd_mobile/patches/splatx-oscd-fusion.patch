 #include <cmath>
 #include <cstdint>
+#include <cstdio>
 #include <cstring>
 #include <limits>
 #include <locale>
@@ -274,6 +275,11 @@ SplatCloud init_splats(const TrainingInput& input, const InitOptions& opts) {
         throw std::invalid_argument("init_splats: seed_points must be non-empty [M,3]");
     if (input.seed_rgb.size() != input.seed_points.size())
         throw std::invalid_argument("init_splats: seed_rgb size != seed_points size");
+    const bool have_normals = !input.seed_normals.empty();
+    if (have_normals && input.seed_normals.size() != input.seed_points.size())
+        throw std::invalid_argument("init_splats: seed_normals size != seed_points size");
+    if (!(opts.normal_scale_ratio > 0.0f))
+        throw std::invalid_argument("init_splats: normal_scale_ratio must be > 0");
     if (opts.max_points < 1)
         throw std::invalid_argument("init_splats: max_points must be >= 1");
     if (!(opts.init_opacity > 0.0f && opts.init_opacity < 1.0f))
@@ -317,13 +323,35 @@ SplatCloud init_splats(const TrainingInput& input, const InitOptions& opts) {
     // grid (knn3_mean_dists — an exact algorithm, bit-identical to brute-force. Phase 6 round 2
     // Task 1).
     const std::vector<float> knn_means = knn3_mean_dists(c.means.data(), N);
+    int64_t discs = 0;
     for (int64_t i = 0; i < N; i++) {
         const float mean_dist = std::max(knn_means[i], 1e-6f);
         const float log_s = std::log(mean_dist * opts.init_scale);
         c.scales[i * 3 + 0] = log_s;
         c.scales[i * 3 + 1] = log_s;
         c.scales[i * 3 + 2] = log_s;
+        if (!have_normals) continue;
+        const int64_t src = i * M / N;
+        float nx = input.seed_normals[src * 3], ny = input.seed_normals[src * 3 + 1], nz = input.seed_normals[src * 3 + 2];
+        const float len = std::sqrt(nx * nx + ny * ny + nz * nz);
+        if (!(len > 1e-6f) || !std::isfinite(len)) continue;
+        nx /= len; ny /= len; nz /= len;
+        // The shortest rotation taking local +z onto n: q = (1 + n_z, −n_y, n_x, 0) (w-first), so the
+        // rotation matrix's third column (the axis scales[2] belongs to — KernelCommon.h
+        // quat_to_rotmat) is n. At n = −z that is degenerate; any half-turn about an in-plane axis does.
+        if (nz < -0.9999f) {
+            c.quats[i * 4 + 0] = 0.0f; c.quats[i * 4 + 1] = 1.0f; c.quats[i * 4 + 2] = 0.0f; c.quats[i * 4 + 3] = 0.0f;
+        } else {
+            const float w = 1.0f + nz, inv = 1.0f / std::sqrt(w * w + ny * ny + nx * nx);
+            c.quats[i * 4 + 0] = w * inv;
+            c.quats[i * 4 + 1] = -ny * inv;
+            c.quats[i * 4 + 2] = nx * inv;
+            c.quats[i * 4 + 3] = 0.0f;
+        }
+        c.scales[i * 3 + 2] = std::log(mean_dist * opts.init_scale * opts.normal_scale_ratio);
+        discs++;
     }
+    if (have_normals) std::printf("init_splats: %lld of %lld Gaussians seeded as surface discs\n", (long long)discs, (long long)N);
     return c;
 }
 
