+        std::vector<float> v_scales;      // [N,3]  log scale
+        std::vector<float> v_opacities;   // [N]    logit
+        std::vector<float> v_sh0;         // [N,3]
+        std::vector<float> v_means2d;     // [N,2]  d loss / d projected position, pixels
+        std::vector<uint8_t> valid;       // [N]    radii > 0
+        std::vector<float> render_colors; // [H,W,3]
