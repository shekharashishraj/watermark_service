 Sources/SplatXCore/Trainer.cpp                | 28 +++++++++++++++++++
 Sources/SplatXCore/TrainingInput.cpp          |  1 +
 .../SplatXCore/include/splatx/ColmapLoader.h  |  3 ++
 Sources/SplatXCore/include/splatx/Trainer.h   |  6 ++++
 .../SplatXCore/include/splatx/TrainingInput.h |  1 +
 6 files changed, 57 insertions(+)

diff --git a/Sources/SplatXCore/ColmapLoader.cpp b/Sources/SplatXCore/ColmapLoader.cpp
index 99f9f06..a722faa 100644
--- a/Sources/SplatXCore/ColmapLoader.cpp
+++ b/Sources/SplatXCore/ColmapLoader.cpp
@@ -250,11 +250,28 @@ void load_points3d_txt(const std::string& path, ColmapBundle& b) {
     }
 }
 
+// normals.txt (optional): "NX NY NZ" per line, one line per points3D entry in the same order. A
+// zero vector means "no normal for this point" (init_splats falls back to an isotropic Gaussian).
+void load_normals_txt(const std::string& path, ColmapBundle& b) {
+    TextReader r(path);
+    std::string line;
+    b.normals.reserve(b.points.size() * 3);
+    while (r.data_line(line)) {
+        const auto t = split_ws(line);
+        if (t.size() != 3) r.fail("expected NX NY NZ, got " + std::to_string(t.size()) + " token(s)");
+        for (int k = 0; k < 3; k++) b.normals.push_back(static_cast<float>(parse_double(r, t[k], "N")));
+    }
+    if (b.normals.size() != b.points.size() * 3)
+        r.fail("normals.txt has " + std::to_string(b.normals.size() / 3) + " lines, points3D has " +
+               std::to_string(b.points.size()));
+}
+
 ColmapBundle load_colmap_bundle_txt(const std::string& dir) {
     ColmapBundle b;
     load_cameras_txt(dir + "/cameras.txt", b);
     load_images_txt(dir + "/images.txt", b);
     load_points3d_txt(dir + "/points3D.txt", b);
+    if (std::ifstream(dir + "/normals.txt").good()) load_normals_txt(dir + "/normals.txt", b);
     return b;
 }
 
@@ -308,6 +325,7 @@ ColmapBundle load_colmap_bundle_bin(const std::string& dir) {
             b.points.push_back(p);
         }
     }
+    if (std::ifstream(dir + "/normals.txt").good()) load_normals_txt(dir + "/normals.txt", b);
     return b;
 }
 
diff --git a/Sources/SplatXCore/Trainer.cpp b/Sources/SplatXCore/Trainer.cpp
