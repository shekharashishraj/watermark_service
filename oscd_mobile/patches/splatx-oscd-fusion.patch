+// oscd_mobile patch — C API for O-SCD change fusion (splatx/OscdFusion.h). All functions return 0 on
+// success and a negative value on failure with a message in err (NUL-terminated). Single-thread use.
+#pragma once
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct OscdFusion OscdFusion;
+
+// Pure helpers (tests).
+float oscd_ssf_loss_and_grad(const float* render, const float* cue, const uint8_t* valid,
+                             int32_t width, int32_t height, float* v_render);
+void oscd_torch_adam(float* param, const float* grad, float* exp_avg, float* exp_avg_sq, int64_t n,
+                     int32_t step, float lr);
+
+// reference_centres: n_centres × 3 floats (world camera centres of the reference scan).
+// kernel_src_dir: splatx Sources/SplatXKernelSrc (compiled on the device); NULL uses the build path.
+OscdFusion* oscd_fusion_open(const char* ply_path, const char* kernel_src_dir,
+                             const float* reference_centres, int32_t n_centres, uint32_t seed,
+                             char* err, int32_t err_len);
+// viewmat: world→camera 4×4 row-major (OpenCV axes); cue/valid: width·height.
+int32_t oscd_fusion_add_frame(OscdFusion* f, const float* viewmat, float fx, float fy, float cx,
+                              float cy, int32_t width, int32_t height, const float* cue,
+                              const uint8_t* valid, char* err, int32_t err_len);
+int32_t oscd_fusion_step_frame(OscdFusion* f, float* out_loss, char* err, int32_t err_len);
+int32_t oscd_fusion_refine(OscdFusion* f, char* err, int32_t err_len);
+// out: width·height channel-mean change values; O-SCD's mask is value > 0.5.
+int32_t oscd_fusion_change_map(OscdFusion* f, const float* viewmat, float fx, float fy, float cx,
+                               float cy, int32_t width, int32_t height, float* out, char* err,
+                               int32_t err_len);
+int64_t oscd_fusion_count(OscdFusion* f);
+int32_t oscd_fusion_total_steps(OscdFusion* f);
+// Test hooks.
