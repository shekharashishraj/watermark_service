# Source this file in every shell and job:   source scd_robustness/setup/sol.env
# Everything (envs, caches, data, outputs) lives under SCD_ROOT on scratch, nothing in $HOME.
# Override any variable by exporting it before sourcing.

SCD_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export SCD_REPO
export SCD_ROOT="${SCD_ROOT:-/scratch/$USER/scd}"
export SCD_ENVS="${SCD_ENVS:-$SCD_ROOT/envs}"

# Sol provides conda/mamba through a module; check `module avail mamba` if this name changes.
export SCD_MAMBA_MODULE="${SCD_MAMBA_MODULE:-mamba/latest}"
# GPU architectures compiled into the CUDA extensions (A100/A30 8.0, A40/A6000 8.6, L40S/4090 8.9, H100 9.0)
export TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST:-8.0;8.6;8.9;9.0}"

# caches: model weights, compiled kernels, package downloads
export HF_HOME="$SCD_ROOT/cache/hf"
export TORCH_HOME="$SCD_ROOT/cache/torch"
export TORCHINDUCTOR_CACHE_DIR="$SCD_ROOT/cache/inductor"
export TORCH_EXTENSIONS_DIR="$SCD_ROOT/cache/torch_extensions"
export TRITON_CACHE_DIR="$SCD_ROOT/cache/triton"
export CUPY_CACHE_DIR="$SCD_ROOT/cache/cupy"
export PIP_CACHE_DIR="$SCD_ROOT/cache/pip"
export CONDA_PKGS_DIRS="$SCD_ROOT/cache/conda_pkgs"
export MPLCONFIGDIR="$SCD_ROOT/cache/matplotlib"
# local clones of torch.hub repos, used by the patched code when compute nodes are offline
export SCD_XFEAT_REPO="${SCD_XFEAT_REPO:-$SCD_ROOT/cache/hub_repos/accelerated_features}"
export SCD_DINOV2_REPO="${SCD_DINOV2_REPO:-$SCD_ROOT/cache/hub_repos/dinov2}"

mkdir -p "$SCD_ROOT"/{envs,code,data/raw,data/variants,runs,manifests,results,logs/slurm} \
         "$HF_HOME" "$TORCH_HOME" "$TORCHINDUCTOR_CACHE_DIR" "$TORCH_EXTENSIONS_DIR" "$TRITON_CACHE_DIR" \
         "$CUPY_CACHE_DIR" "$PIP_CACHE_DIR" "$CONDA_PKGS_DIRS" "$MPLCONFIGDIR" "$SCD_ROOT/cache/hub_repos"

# Offline mode for Hugging Face inside jobs (weights are pre-staged by setup/04_prestage_models.sh).
scd_offline() { export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1; }

# Activate one of: scd-tools | oscd | mv3dcd
scd_activate() {
    local name="$1"
    if ! command -v conda >/dev/null 2>&1; then
        module load "$SCD_MAMBA_MODULE" >/dev/null 2>&1 || {
            echo "[scd] could not load module $SCD_MAMBA_MODULE (see: module avail mamba)" >&2; return 1; }
    fi
    if [ ! -d "$SCD_ENVS/$name" ]; then
        echo "[scd] environment $SCD_ENVS/$name does not exist; run setup/02_create_envs.sh $name" >&2
        return 1
    fi
    eval "$(conda shell.bash hook)" 2>/dev/null
    conda activate "$SCD_ENVS/$name" 2>/dev/null || source activate "$SCD_ENVS/$name"
}
